; Engine configuration file.
config_version=5

[application]

config/name="HemoShift"
config/description="MLT hematology exam prep lab-shift game"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Content="*res://scripts/autoload/content.gd"
Progress="*res://scripts/autoload/progress.gd"
Nav="*res://scripts/autoload/nav.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[importer_defaults]

texture={
"compress/mode": 1,
"compress/lossy_quality": 0.8
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
